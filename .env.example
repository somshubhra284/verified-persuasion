# Copy to .env (never commit .env). The same values go into Render's Environment settings.
OPENROUTER_API_KEY=                 # study provider: OpenRouter pinned to DeepInfra (code default)
# GROQ_API_KEY=                     # only if running with PROVIDER=groq
# MODEL=openai/gpt-oss-120b

# Live site (Render backend + Supabase)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=                # Supabase > Project Settings > API Keys > secret key (sb_secret_...)
SESSION_SECRET=                     # any long random string; signs session tokens and day-7 links
ALLOWED_ORIGIN=https://<hf-user>-verified-persuasion.static.hf.space
APP_URL=https://<hf-user>-verified-persuasion.static.hf.space
